TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NEWS_THREAD_ID=0
TELEGRAM_MONITOR_THREAD_ID=0

# Optional structured macro/earnings data. Needs both lines.
RADAR_FMP_ENABLED=false
FMP_API_KEY=

# Optional OpenAI-compatible translation/compression endpoint.
# LLM_* replaced the older FE_LLM_* names, which are still honoured.
RADAR_LLM_ENABLED=false
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# Leave empty to send the built-in "global-news-radar/<version>" agent, which
# tracks releases on its own. A pinned string here goes stale silently.
RADAR_USER_AGENT=
